<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AcademiaLink</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="bg-gradient-to-b from-white via-gray-50 to-white min-h-screen text-gray-800">
    <header class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center shadow-md">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 12a9 9 0 0112.728-8.364L21 6v8l-5.272 2.364A9 9 0 013 12z" fill="#6366f1"/></svg>
        </div>
        <span class="text-xl font-semibold">AcademiaLink</span>
      </div>
      <nav class="hidden md:flex gap-6 text-sm text-gray-600">
        <a href="#">How it works</a>
        <a href="#">Features</a>
        <a href="#">Support</a>
      </nav>
    </header>

    <main class="max-w-6xl mx-auto px-6">
      <section class="text-center py-16">
        <p class="text-xs uppercase text-indigo-500 inline-flex items-center gap-2 font-medium">Powered by AI</p>
        <h1 class="mt-6 text-4xl md:text-6xl font-extrabold leading-tight">
          Unlock Academic
          <span class="text-indigo-600"> Knowledge Instantly</span>
        </h1>
        <p class="mt-4 text-gray-600 max-w-2xl mx-auto">Enter a document URL to auto-generate citations, summaries, and access download links in seconds.</p>

        <div class="mt-8 max-w-3xl mx-auto">
          <form action="/download" method="post" class="flex gap-3 items-center">
            <input type="text" id="url" name="url" placeholder="Paste Academia.edu, ResearchGate, or DOI link..." required
                   class="flex-1 px-5 py-4 rounded-lg shadow-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-300" />
            <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-lg shadow hover:bg-indigo-700">Get File</button>
          </form>
        </div>

      </section>

      <section class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
        <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 bg-indigo-50 rounded-lg flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2v20" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <h3 class="font-semibold mb-2">Universal Access</h3>
          <p class="text-sm text-gray-600">Supports major academic repositories and direct PDF links.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 bg-indigo-50 rounded-lg flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 12h18" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <h3 class="font-semibold mb-2">Smart Validation</h3>
          <p class="text-sm text-gray-600">Automatically checks link integrity and file availability.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 bg-indigo-50 rounded-lg flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <h3 class="font-semibold mb-2">Auto-Citation</h3>
          <p class="text-sm text-gray-600">Instantly generates APA, MLA, and Chicago citations.</p>
        </div>
      </section>

      <% if @result %>
        <section class="mb-20">
          <div class="bg-white p-6 rounded-lg shadow">
            <h2 class="text-lg font-semibold">Result</h2>
            <pre class="mt-3 text-sm text-gray-700 whitespace-pre-wrap"><%= @result %></pre>
          </div>
        </section>
      <% end %>

    </main>

    <footer class="text-center text-sm text-gray-500 py-8">
      &copy; <%= Time.now.year %> AcademiaLink
    </footer>
  </body>
</html>